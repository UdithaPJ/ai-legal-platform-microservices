.idea/
.vscode/
*.iml

# Build outputs
target/
build/
dist/
out/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Ignore all Markdown files except README.md
*.md
!**/README.md

# ── Secrets — never commit ───────────────────────────────────────────────────

# Cloudflare Tunnel credentials
infrastructure/.env.tunnel
infrastructure/cloudflare/tunnel-credentials.json
infrastructure/cloudflare/*.json

# 8x8 JaaS private key (directory contains the RSA .pk file)
infrastructure/jaas/
infrastructure/.env.jitsi

# Postgres backup dumps — contain real user data (emails, phone numbers,
# messages, documents metadata), never commit
infrastructure/postgres/backups/

# Frontend environment files (contain AUTH_SECRET + Keycloak client secret)
legal-platform-web/.env.tunnel
legal-platform-web/.env.local
legal-platform-web/.env.production
legal-platform-web/.env*.local

# Generic secret patterns — belt and suspenders
*.pk
*.pem
*_private_key*
*-private-key*
**/credentials.json
**/secrets.json
